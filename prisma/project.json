{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "multiband-prisma",
  "root": "prisma",
  "sourceRoot": "prisma",
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma generate --schema=prisma/schema.prisma",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    }
  }
}
